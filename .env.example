PRODUCERSCENTER_BACKEND_NAME=ProducersCenter Backend
PRODUCERSCENTER_BACKEND_DEBUG=false
# PostgreSQL is the primary backend database.
# Render/Heroku style postgres:// URLs are accepted and normalized by the app.
PRODUCERSCENTER_BACKEND_DATABASE_URL=postgresql+psycopg://producerscenter:change-me@localhost:5432/producerscenter_backend
# Render usually exposes the same value as DATABASE_URL. The backend accepts it too.
# DATABASE_URL=postgres://user:password@host:5432/database
# Local fallback:
# PRODUCERSCENTER_BACKEND_DATABASE_URL=sqlite:///./storage/backend.db
# Required in every deployed resolver. The PWA/Resolver Gateway sends this
# value as Authorization: Bearer <value>; do not expose it in the browser.
PRODUCERSCENTER_BACKEND_API_KEY=change-me-long-random-secret
# Separate password for the browser dashboard. It creates a Secure, HttpOnly
# session cookie and must not match the API key or any Cloudflare secret.
PRODUCERSCENTER_BACKEND_DASHBOARD_PASSWORD=change-me-different-dashboard-password
# Optional; defaults to 12 hours. Minimum effective value is 300 seconds.
PRODUCERSCENTER_BACKEND_DASHBOARD_SESSION_TTL_SECONDS=43200
PRODUCERSCENTER_BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8787
PRODUCERSCENTER_BACKEND_PROXY_CHECK_CONCURRENCY=30
PRODUCERSCENTER_BACKEND_STREAM_RESOLVE_CONCURRENCY=4
PRODUCERSCENTER_BACKEND_PROXY_ATTEMPTS=3
# Googlevideo URLs are temporary; 0.25 hours = 15 minutes.
PRODUCERSCENTER_BACKEND_STREAM_CACHE_HOURS=0.25
PRODUCERSCENTER_BACKEND_DIRECT_FIRST=false
PRODUCERSCENTER_BACKEND_SEARCH_TIMEOUT_SECONDS=15
PRODUCERSCENTER_BACKEND_STREAM_RESOLVE_TIMEOUT_SECONDS=35
PRODUCERSCENTER_BACKEND_YTDLP_SOCKET_TIMEOUT_SECONDS=8
PRODUCERSCENTER_BACKEND_YTDLP_RETRIES=0
# Per Render instance. At this limit /api/health returns 503 and the gateway
# switches to a different healthy node.
PRODUCERSCENTER_BACKEND_MAX_CONCURRENT_REQUESTS=4
